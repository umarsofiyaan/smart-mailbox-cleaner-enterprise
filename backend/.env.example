# ============================================================
# Smart Mailbox Cleaner — Backend Environment Variables
# Copy to .env and fill in all values before running
# ============================================================

# Server
NODE_ENV=development
PORT=3001

# Domains (replace with production values)
FRONTEND_URL=https://app.mailboxcleaner.umarsofiyaan.shop
BACKEND_URL=https://api.mailboxcleaner.umarsofiyaan.shop
EXTENSION_ID=your_chrome_extension_id_here

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DB_SSL=true

# Google OAuth 2.0
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.mailboxcleaner.umarsofiyaan.shop/auth/google/callback

# JWT Secrets (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=generate_64_byte_hex_secret_here
JWT_REFRESH_SECRET=generate_different_64_byte_hex_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (AES-256 for refresh tokens — generate with: openssl rand -hex 32)
ENCRYPTION_KEY=generate_32_byte_hex_secret_here

# Razorpay
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_PLAN_ID=plan_your_plan_id
RAZORPAY_PLAN_ID_STARTER=plan_starter_id
RAZORPAY_PLAN_ID_PRO=plan_pro_id
RAZORPAY_PLAN_ID_POWER=plan_power_id

# Optional regional pricing fallback provider token
IPINFO_TOKEN=

# Sentry Error Tracking
# Get from: https://sentry.io → New Project → Node.js
# Leave blank to disable Sentry (safe for local dev)
SENTRY_DSN=https://your_key@oXXXXX.ingest.sentry.io/XXXXXXX

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
GMAIL_RATE_LIMIT_DELAY_MS=100
