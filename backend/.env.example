# ============================================================
# Smart Mailbox Cleaner — Backend Environment Variables
# Copy to .env and fill in all values before running
# ============================================================

# Server
NODE_ENV=development
PORT=3001

# Domains (replace with production values)
FRONTEND_URL=https://app.mailboxcleaner.umarsofiyaan.shop
BACKEND_URL=https://api.mailboxcleaner.umarsofiyaan.shop
EXTENSION_ID=your_chrome_extension_id_here

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DB_SSL=true

# Google OAuth 2.0
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.mailboxcleaner.umarsofiyaan.shop/auth/google/callback

# JWT Secrets (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=generate_64_byte_hex_secret_here
JWT_REFRESH_SECRET=generate_different_64_byte_hex_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (AES-256 for refresh tokens — generate with: openssl rand -hex 32)
ENCRYPTION_KEY=generate_32_byte_hex_secret_here

# Stripe
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRO_PRICE_ID=price_your_pro_plan_price_id
STRIPE_PRO_PRODUCT_ID=prod_your_pro_product_id

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
GMAIL_RATE_LIMIT_DELAY_MS=100
