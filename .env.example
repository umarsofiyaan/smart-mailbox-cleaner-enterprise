# ═══════════════════════════════════════════════════════════════════════
# Smart Mailbox Cleaner — Enterprise Self-Hosted Configuration
# Copy to .env and fill in all required values
# Deploy: docker compose up -d
# ═══════════════════════════════════════════════════════════════════════

# ─── Enterprise License (required) ────────────────────────────────
# Contact enterprise@smartmailboxcleaner.com to get your license key
ENTERPRISE_MODE=true
LICENSE_KEY=SMC-ENT-your-license-key-here

# ─── Database ─────────────────────────────────────────────────────────
POSTGRES_DB=smartmailbox
POSTGRES_USER=smartmailbox
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24

# ─── URLs (set to your organization's domain) ────────────────────────
# Example: https://mailclean.yourcompany.com
FRONTEND_URL=https://mailclean.yourcompany.com
BACKEND_URL=https://mailclean-api.yourcompany.com
COOKIE_DOMAIN=.yourcompany.com
FRONTEND_PORT=8080

# ─── Google OAuth 2.0 (from YOUR organization's GCP project) ────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect: ${BACKEND_URL}/auth/google/callback
# 4. Enable Gmail API + Google Drive API in your GCP project
GOOGLE_CLIENT_ID=your_org_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_org_client_secret

# ─── Security Secrets ────────────────────────────────────────────────
# Generate each with: openssl rand -hex 64
JWT_ACCESS_SECRET=GENERATE_ME_openssl_rand_hex_64
JWT_REFRESH_SECRET=GENERATE_ME_DIFFERENT_openssl_rand_hex_64
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=GENERATE_ME_openssl_rand_hex_32
OAUTH_STATE_SECRET=GENERATE_ME_openssl_rand_hex_32

# ─── Domain Restriction ──────────────────────────────────────────────
# Only users with these email domains can sign in (comma-separated)
# Leave empty to allow all domains
WORKSPACE_DOMAIN_ALLOWLIST=yourcompany.com

# ─── Email Notifications (Optional) ──────────────────────────────────
# SMTP for cleanup reports, plan reminders, etc.
EMAIL_FROM="Smart Mailbox Cleaner <noreply@yourcompany.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourcompany.com
SMTP_PASS=your_app_password
# Or use Resend instead of SMTP:
RESEND_API_KEY=

# ─── Payment (Optional) ──────────────────────────────────────────────
# Leave empty to disable billing (all users get unlimited access)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Object Storage (Optional — for email export feature) ────────────
# Any S3-compatible storage (AWS S3, Cloudflare R2, MinIO, etc.)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ─── Monitoring (Optional) ───────────────────────────────────────────
SENTRY_DSN=

# ─── Feature Flags ───────────────────────────────────────────────────
ENABLE_SCAN_DIAGNOSE=false
