# ============================================================
# Smart Mailbox Cleaner — Frontend Environment Variables
# Copy to .env.local and fill in all values before running
# ============================================================

# API
VITE_API_URL=https://api.mailboxcleaner.umarsofiyaan.shop

# Razorpay
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id

# Sentry Error Tracking (frontend)
# Get from: https://sentry.io → New Project → React
# Leave blank to disable Sentry (safe for local dev)
VITE_SENTRY_DSN=https://your_key@oXXXXX.ingest.sentry.io/XXXXXXX
VITE_APP_VERSION=1.0.0
